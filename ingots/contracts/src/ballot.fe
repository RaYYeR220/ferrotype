//! The ballot box: proposals and votes, kept apart from where the vote
//! weights come from.
//!
//! Every function here names, in its `uses` clause, exactly the storage it
//! reads or writes. None of them can call another contract or move funds:
//! they are not given the capability to.

use std::evm::{StorageMap, keccak_words}
use ferrotype::state::StorageRoot

/// Why a governance action was refused.
#[error]
pub struct Refused { pub reason: u8 }

/// The proposal id is 0 or was never opened.
pub const UNKNOWN_PROPOSAL: u8 = 1
/// A vote arrived at or after the proposal's deadline.
pub const VOTING_CLOSED: u8 = 2
/// `Execute` before the proposal's deadline.
pub const VOTING_OPEN: u8 = 3
/// This address has already voted on this proposal.
pub const ALREADY_VOTED: u8 = 4
/// The voter held none of the token at the snapshot block.
pub const NO_WEIGHT: u8 = 5
/// The token flags this holder (USDC's blacklist bit) at the snapshot block.
pub const FLAGGED_HOLDER: u8 = 6
/// Voting is over and the proposal did not pass: no more weight for than
/// against, or the weight for is short of the quorum.
pub const NOT_PASSED: u8 = 7
/// The proposal has already been executed.
pub const ALREADY_EXECUTED: u8 = 8
/// `Execute` was given other calldata than the proposal was opened with.
pub const WRONG_CALLDATA: u8 = 9
/// The header's block is not one of the last `max_snapshot_age` blocks, or
/// `BLOCKHASH` does not return the header's hash for it.
pub const UNKNOWN_BLOCK: u8 = 10
/// The header does not decode as a block header.
pub const BAD_HEADER: u8 = 11
/// The proposal's call reverted.
pub const CALL_FAILED: u8 = 12
/// A constructor argument is out of range (see `Plebiscite`'s `init`).
pub const BAD_CONFIG: u8 = 13
/// The token's total supply at the snapshot block is zero.
pub const NO_SUPPLY: u8 = 14
/// The proposer's balance at the snapshot block is below the proposal
/// threshold.
pub const BELOW_THRESHOLD: u8 = 15
/// A vote's weight is larger than the token's total supply at the snapshot.
pub const WEIGHT_ABOVE_SUPPLY: u8 = 16
/// Voting is over, but the timelock after it has not passed yet.
pub const TIMELOCKED: u8 = 17
/// The grace period after the timelock is over: the proposal can no longer
/// be executed.
pub const EXPIRED: u8 = 18
/// Not enough gas is left to forward the proposal's gas to its call.
pub const INSUFFICIENT_GAS: u8 = 19

/// Reverts with `Refused { reason }`.
pub fn refuse(_ reason: u8) -> ! {
    std::evm::revert_error(Refused { reason })
}

/// The token's state at the block a proposal counts votes at.
pub struct Snapshot { pub block: u256, pub storage_root: StorageRoot, pub supply: u256 }

impl Copy for Snapshot {}

/// One proposal: a single call the treasury makes if the vote passes.
pub struct Proposal {
    pub proposer: Address,
    pub target: Address,
    pub value: Wei,
    /// Keccak-256 of the calldata; the calldata itself is passed again to `execute`.
    pub data_hash: u256,
    /// The gas the call is made with, exactly.
    pub gas: u256,
    pub snapshot_block: u256,
    pub storage_root: u256,
    pub supply: u256,
    pub deadline: Timestamp,
    pub votes_for: u256,
    pub votes_against: u256,
    pub executed: bool,
}

impl Copy for Proposal {}

/// All proposals and who voted on which.
pub struct Ledger {
    pub proposals: StorageMap<u256, Proposal>,
    pub ballots: StorageMap<u256, bool>,
    pub count: u256,
}

/// `ceil(supply * bps / 10000)`, for `bps` at most 10000, computed without
/// a product that can exceed 2^256: the share of the whole ten-thousandths,
/// then of the remainder.
pub fn share(supply: u256, bps: u256) -> u256 {
    let rest = (supply % 10000) * bps
    (supply / 10000) * bps + rest / 10000 + if rest % 10000 == 0 { 0 } else { 1 }
}

/// Opens a proposal counting votes at `snapshot`, until `deadline`.
pub fn open(
    proposer: Address,
    target: Address,
    value: Wei,
    data_hash: u256,
    gas: u256,
    snapshot: Snapshot,
    deadline: Timestamp,
) -> u256
uses (ledger: mut Ledger)
{
    ledger.count += 1
    let id = ledger.count
    ledger
        .proposals
        .set(
            key: id,
            value: Proposal {
                proposer,
                target,
                value,
                data_hash,
                gas,
                snapshot_block: snapshot.block,
                storage_root: snapshot.storage_root.value,
                supply: snapshot.supply,
                deadline,
                votes_for: 0,
                votes_against: 0,
                executed: false,
            },
        )
    id
}

/// The proposal `id`; refuses an unknown id.
pub fn get(_ id: u256) -> Proposal uses (ledger: Ledger) {
    if id == 0 || id > ledger.count {
        refuse(UNKNOWN_PROPOSAL)
    }
    ledger.proposals.get(key: id)
}

/// Whether `voter` has voted on `id`.
pub fn has_voted(_ id: u256, voter: Address) -> bool uses (ledger: Ledger) {
    ledger.ballots.get(key: ballot_key(id, voter))
}

/// Records `voter`'s `weight` for or against `id` at time `now`.
pub fn cast(_ id: u256, voter: Address, weight: u256, support: bool, now: Timestamp)
uses (ledger: mut Ledger)
{
    var proposal = get(id)
    if now >= proposal.deadline {
        refuse(VOTING_CLOSED)
    }
    let key = ballot_key(id, voter)
    if ledger.ballots.get(key: key) {
        refuse(ALREADY_VOTED)
    }
    if weight == 0 {
        refuse(NO_WEIGHT)
    }
    // No holder can hold more than the whole supply; a token whose storage
    // says otherwise is not counted.
    if weight > proposal.supply {
        refuse(WEIGHT_ABOVE_SUPPLY)
    }
    ledger.ballots.set(key: key, value: true)
    if support {
        proposal.votes_for += weight
    } else {
        proposal.votes_against += weight
    }
    ledger.proposals.set(key: id, value: proposal)
}

/// Whether `id` passed: voting is over, more weight for than against, and
/// the weight for reaches `quorum_bps` basis points of the snapshot supply.
pub fn passed(_ proposal: Proposal, now: Timestamp, quorum_bps: u256) -> bool {
    now >= proposal.deadline
        && proposal.votes_for > proposal.votes_against
        && proposal.votes_for >= share(supply: proposal.supply, bps: quorum_bps)
}

/// Marks `id` executed if it can be executed at `now` and `data` is the
/// calldata it was opened with; returns the proposal to execute. A proposal
/// can be executed once, from `timelock` after its deadline until `grace`
/// after that, and only if it passed.
pub fn settle(
    _ id: u256,
    data_hash: u256,
    now: Timestamp,
    quorum_bps: u256,
    timelock: Duration,
    grace: Duration,
) -> Proposal
uses (ledger: mut Ledger)
{
    var proposal = get(id)
    if proposal.executed {
        refuse(ALREADY_EXECUTED)
    }
    if now < proposal.deadline {
        refuse(VOTING_OPEN)
    }
    // Measured from the deadline, so no sum of durations can overflow.
    let since = now - proposal.deadline
    if since < timelock {
        refuse(TIMELOCKED)
    }
    if since - timelock >= grace {
        refuse(EXPIRED)
    }
    if !passed(proposal, now, quorum_bps) {
        refuse(NOT_PASSED)
    }
    if data_hash != proposal.data_hash {
        refuse(WRONG_CALLDATA)
    }
    proposal.executed = true
    ledger.proposals.set(key: id, value: proposal)
    proposal
}

fn ballot_key(_ id: u256, _ voter: Address) -> u256 {
    keccak_words([id, voter.word()])
}
