//! Plebiscite: a treasury governed by the holders of an ERC-20 token that
//! knows nothing about governance. Votes are counted from the token's own
//! storage at the block a proposal was opened at, proven with Merkle-Patricia
//! proofs, so the token needs no checkpoints and no one runs a snapshot
//! server.
//!
//! Opening a proposal anchors it to a block the chain still remembers: the
//! header must hash to `BLOCKHASH` (or the EIP-2935 history), its state root
//! proves the token's account, and the account's storage root is kept. From
//! then on a vote needs only one storage proof: the voter's balance slot.
//!
//! What each handler may touch is in its `uses` clause: a handler that does
//! not list an effect or a field cannot reach it. Only `Propose` and `Execute`
//! list `call`, and each passes it to one free function whose own `uses`
//! clause the compiler checks: `history::block_hash` takes it read-only, which
//! allows nothing but `STATICCALL`; `pay`, reached only from `Execute`, takes
//! it mutably and is the treasury's one outgoing call. (Fe 26.6 does not yet
//! check the `mut` marker on a contract-level effect inside a `recv` arm, so
//! the arms do not call `call` themselves.)

use std::abi::Bytes
use std::evm::{keccak256, wei}
use ferrotype::nodes::Packed
use ferrotype::slots::BalanceLayout
use ferrotype::state::{self, StorageRoot}
use ingot::ballot::{self, Ledger, Proposal, Snapshot, refuse}
use ingot::errors::reject
use ingot::history

pub msg PlebisciteMsg {
    /// Opens a proposal counted at the block `header` describes. The proofs
    /// are the token's account proof and its total-supply slot proof at that
    /// block, packed (nodes end to end). Returns the proposal id.
    #[selector = sol("propose(bytes,bytes,bytes,address,uint256,bytes)")]
    Propose {
        header: Bytes,
        token_proof: Bytes,
        supply_proof: Bytes,
        target: Address,
        value: u256,
        data: Bytes,
    } -> u256,

    /// Votes with the caller's balance at the proposal's block, proven by
    /// `balance_proof` (the balance slot's storage proof, packed). Returns
    /// the weight counted.
    #[selector = sol("vote(uint256,bool,bytes)")]
    Vote { id: u256, support: bool, balance_proof: Bytes } -> u256,

    /// The weight `holder` would vote with on proposal `id`.
    #[selector = sol("votingPower(uint256,address,bytes)")]
    VotingPower { id: u256, holder: Address, balance_proof: Bytes } -> u256,

    /// Makes the proposal's call from the treasury once it has passed.
    #[selector = sol("execute(uint256,bytes)")]
    Execute { id: u256, data: Bytes } -> bool,

    /// Adds the attached ether to the treasury; returns the new balance.
    #[selector = sol("deposit()")]
    Deposit -> u256,

    #[selector = sol("hasVoted(uint256,address)")]
    HasVoted { id: u256, voter: Address } -> bool,

    #[selector = sol("proposalCount()")]
    ProposalCount -> u256,

    /// `(block, storageRoot, supply)`: the token state proposal `id` counts
    /// votes against. A voter's balance proof must lead to `storageRoot`.
    #[selector = sol("snapshot(uint256)")]
    SnapshotOf { id: u256 } -> (u256, u256, u256),

    /// `(votesFor, votesAgainst, supply, deadline, snapshotBlock, executed)`.
    #[selector = sol("tally(uint256)")]
    Tally { id: u256 } -> (u256, u256, u256, u256, u256, bool),

    /// `(token, layoutKind, balanceSlot, supplySlot, votingPeriod, quorumBps, maxSnapshotAge)`.
    #[selector = sol("config()")]
    Config -> (Address, u8, u256, u256, u256, u256, u256),
}

#[event]
pub struct Proposed {
    #[indexed]
    pub id: u256,
    #[indexed]
    pub proposer: Address,
    pub snapshot_block: u256,
    pub supply: u256,
    pub deadline: Timestamp,
    pub target: Address,
    pub value: Wei,
}

#[event]
pub struct Voted {
    #[indexed]
    pub id: u256,
    #[indexed]
    pub voter: Address,
    pub support: bool,
    pub weight: u256,
}

#[event]
pub struct Executed {
    #[indexed]
    pub id: u256,
    pub target: Address,
    pub value: Wei,
}

pub contract Plebiscite uses (ctx: Ctx, call: mut Call, log: mut Log) {
    token: Address,
    layout_kind: u8,
    balance_slot: u256,
    supply_slot: u256,
    voting_period: Duration,
    quorum_bps: u256,
    max_snapshot_age: u256,
    mut ledger: Ledger,

    init(
        token_address: Address,
        layout: u8,
        balances_at: u256,
        supply_at: u256,
        period: Duration,
        quorum: u256,
        max_age: u256,
    ) uses (mut token, mut layout_kind, mut balance_slot, mut supply_slot, mut voting_period, mut quorum_bps, mut max_snapshot_age) {
        assert!(BalanceLayout::from_parts(kind: layout, slot: balances_at).is_some(), "unknown balance layout")
        assert!(quorum <= 10000, "quorum above 100%")
        assert!(max_age >= 1 && max_age <= history::HISTORY_WINDOW, "snapshot age outside the history window")
        token = token_address
        layout_kind = layout
        balance_slot = balances_at
        supply_slot = supply_at
        voting_period = period
        quorum_bps = quorum
        max_snapshot_age = max_age
    }

    recv PlebisciteMsg {
        Propose { header, token_proof, supply_proof, target, value, data } -> u256
            uses (ctx, call, token, supply_slot, voting_period, max_snapshot_age, mut ledger, mut log)
        {
            let snapshot = anchor(header, token_proof, supply_proof, token, supply_slot, max_age: max_snapshot_age)
            let deadline = ctx.timestamp() + voting_period
            let amount = wei(value)
            let id = ballot::open(
                proposer: ctx.caller(),
                target,
                value: amount,
                data_hash: keccak256(data.span()),
                snapshot,
                deadline,
            )
            log.emit(Proposed {
                id,
                proposer: ctx.caller(),
                snapshot_block: snapshot.block,
                supply: snapshot.supply,
                deadline,
                target,
                value: amount,
            })
            id
        }

        Vote { id, support, balance_proof } -> u256 uses (ctx, layout_kind, balance_slot, mut ledger, mut log) {
            let voter = ctx.caller()
            let proposal = ballot::get(id)
            let weight = weight_of(proposal, holder: voter, proof: balance_proof, kind: layout_kind, slot: balance_slot)
            ballot::cast(id, voter, weight, support, now: ctx.timestamp())
            log.emit(Voted { id, voter, support, weight })
            weight
        }

        VotingPower { id, holder, balance_proof } -> u256 uses (layout_kind, balance_slot, ledger) {
            let proposal = ballot::get(id)
            weight_of(proposal, holder, proof: balance_proof, kind: layout_kind, slot: balance_slot)
        }

        Execute { id, data } -> bool uses (ctx, mut call, quorum_bps, mut ledger, mut log) {
            // Marked executed before the call, so the call cannot re-enter it.
            let proposal = ballot::settle(id, data_hash: keccak256(data.span()), now: ctx.timestamp(), quorum_bps)
            if !pay(proposal.target, proposal.value, data) {
                refuse(ballot::CALL_FAILED)
            }
            log.emit(Executed { id, target: proposal.target, value: proposal.value })
            true
        }

        #[payable]
        Deposit -> u256 uses (ctx) {
            ctx.selfbalance().as_wei()
        }

        HasVoted { id, voter } -> bool uses (ledger) {
            ballot::has_voted(id, voter)
        }

        ProposalCount -> u256 uses (ledger) {
            ledger.count
        }

        SnapshotOf { id } -> (u256, u256, u256) uses (ledger) {
            let p = ballot::get(id)
            (p.snapshot_block, p.storage_root, p.supply)
        }

        Tally { id } -> (u256, u256, u256, u256, u256, bool) uses (ledger) {
            let p = ballot::get(id)
            (p.votes_for, p.votes_against, p.supply, p.deadline.as_seconds(), p.snapshot_block, p.executed)
        }

        Config -> (Address, u8, u256, u256, u256, u256, u256)
            uses (token, layout_kind, balance_slot, supply_slot, voting_period, quorum_bps, max_snapshot_age)
        {
            (token, layout_kind, balance_slot, supply_slot, voting_period.as_seconds(), quorum_bps, max_snapshot_age)
        }
    }
}

/// The treasury's one outgoing call: `data` to `target` with `value` attached.
/// Every call the contract makes goes through a free function like this one
/// or `history::block_hash`, whose `uses` clause the compiler checks: this one
/// takes `call` mutably, `block_hash` takes it read-only.
fn pay(_ target: Address, _ value: Wei, _ data: Bytes) -> bool uses (ctx: Ctx, call: mut Call) {
    call.try_call_raw(addr: target, gas: ctx.gas() - 5000, value, args: data.span()).success()
}

/// Proves the token's storage root and total supply at the block `header`
/// describes, after checking the chain remembers that block by this hash.
fn anchor(_ header: Bytes, _ token_proof: Bytes, _ supply_proof: Bytes, _ token: Address, _ supply_slot: u256, max_age: u256) -> Snapshot
    uses (ctx: Ctx, call: Call)
{
    let h = match state::header(header.span(), at: 0, len: header.len()) {
        Option::Some(h) => h
        Option::None => refuse(ballot::BAD_HEADER)
    }
    let current = ctx.block_number()
    if h.number >= current || current - h.number > max_age {
        refuse(ballot::UNKNOWN_BLOCK)
    }
    match history::block_hash(h.number) {
        Option::Some(hash) => {
            if hash != h.hash.value {
                refuse(ballot::UNKNOWN_BLOCK)
            }
        }
        Option::None => refuse(ballot::UNKNOWN_BLOCK)
    }
    var account_nodes = Packed::new(start: 0, len: token_proof.len())
    let account = match state::account(token_proof.span(), nodes: mut account_nodes, root: h.state_root, address: token) {
        Result::Ok(account) => account
        Result::Err(e) => reject(e)
    }
    var supply_nodes = Packed::new(start: 0, len: supply_proof.len())
    let supply = match state::storage(supply_proof.span(), nodes: mut supply_nodes, root: account.storage_root, slot: supply_slot) {
        Result::Ok(value) => value
        Result::Err(e) => reject(e)
    }
    Snapshot { block: h.number, storage_root: account.storage_root, supply }
}

/// The balance `holder` held at the proposal's block, under the token's
/// layout. A holder the token flags (USDC's blacklist bit) cannot vote.
pub fn weight_of(_ proposal: Proposal, holder: Address, proof: Bytes, kind: u8, slot: u256) -> u256 {
    let layout = BalanceLayout::from_parts(kind, slot).unwrap()
    var nodes = Packed::new(start: 0, len: proof.len())
    let word = match state::storage(proof.span(), nodes: mut nodes, root: StorageRoot { value: proposal.storage_root }, slot: layout.slot(holder)) {
        Result::Ok(word) => word
        Result::Err(e) => reject(e)
    }
    let balance = layout.balance(word)
    if balance.flagged {
        refuse(ballot::FLAGGED_HOLDER)
    }
    balance.amount
}
