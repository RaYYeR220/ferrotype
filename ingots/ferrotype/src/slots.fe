//! Where compilers put things in storage, and how to read them back.
//!
//! A storage proof proves one 32-byte slot. Turning a Solidity or Vyper
//! variable into that slot, and the slot's word back into the variable, is
//! the other half of reading another contract's state.

use ingot::hash::keccak_words

/// Solidity `mapping(K => V)` declared at slot `slot`: the entry for `key`
/// lives at `keccak256(key . slot)`.
pub fn solidity_mapping(slot: u256, key: u256) -> u256 {
    keccak_words([key, slot])
}

/// Vyper `HashMap[K, V]` declared at slot `slot`: the entry for `key` lives at
/// `keccak256(slot . key)`, the other way round from Solidity.
pub fn vyper_mapping(slot: u256, key: u256) -> u256 {
    keccak_words([slot, key])
}

/// Element `index` of a Solidity dynamic array declared at slot `slot`, one
/// slot per element. The addition wraps around 2^256, as Solidity's does.
pub fn solidity_array(slot: u256, index: u256) -> u256 {
    keccak_words([slot]).wrapping_add(index)
}

/// An address as a mapping key: left-padded to 32 bytes.
pub fn address_key(_ address: Address) -> u256 {
    address.word()
}

/// How a token keeps its balances, so a proven slot reads as a balance.
pub enum BalanceLayout {
    /// `mapping(address => uint256)` at the given slot: OpenZeppelin ERC-20
    /// (slot 0), WETH9 (slot 3), DAI (slot 2).
    Solidity(u256),
    /// Vyper `HashMap[address, uint256]` at the given slot.
    Vyper(u256),
    /// A Solidity mapping whose top bit is a flag and whose low 255 bits are
    /// the balance. USDC (FiatToken v2.2) keeps `balanceAndBlacklistStates`
    /// this way at slot 9: the top bit marks a blacklisted account.
    FlaggedSolidity(u256),
}

impl Copy for BalanceLayout {}

/// A balance read from storage, with the flag a packed layout keeps beside it.
pub struct Balance { pub amount: u256, pub flagged: bool }

impl Copy for Balance {}

const LOW_255: u256 = 0x7fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff

impl BalanceLayout {
    /// The storage slot holding `holder`'s balance.
    pub fn slot(self, _ holder: Address) -> u256 {
        match self {
            BalanceLayout::Solidity(base) => solidity_mapping(slot: base, key: address_key(holder)),
            BalanceLayout::Vyper(base) => vyper_mapping(slot: base, key: address_key(holder)),
            BalanceLayout::FlaggedSolidity(base) => solidity_mapping(
                slot: base,
                key: address_key(holder),
            ),
        }
    }

    /// The balance a slot's word holds under this layout.
    pub fn balance(self, _ word: u256) -> Balance {
        match self {
            BalanceLayout::FlaggedSolidity(_) => Balance {
                amount: word & LOW_255,
                flagged: (word >> 255) == 1,
            },
            _ => Balance { amount: word, flagged: false },
        }
    }

    /// Encodes the layout as `(kind, slot)` for calldata and storage.
    pub fn kind(self) -> u8 {
        match self {
            BalanceLayout::Solidity(_) => 0,
            BalanceLayout::Vyper(_) => 1,
            BalanceLayout::FlaggedSolidity(_) => 2,
        }
    }

    pub fn base_slot(self) -> u256 {
        match self {
            BalanceLayout::Solidity(base) => base,
            BalanceLayout::Vyper(base) => base,
            BalanceLayout::FlaggedSolidity(base) => base,
        }
    }

    /// The layout `kind` names, or `None` for an unknown kind.
    pub fn from_parts(kind: u8, slot: u256) -> Option<Self> {
        match kind {
            0 => Option::Some(BalanceLayout::Solidity(slot)),
            1 => Option::Some(BalanceLayout::Vyper(slot)),
            2 => Option::Some(BalanceLayout::FlaggedSolidity(slot)),
            _ => Option::None,
        }
    }
}
