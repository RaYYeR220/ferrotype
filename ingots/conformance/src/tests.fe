//! Real mainnet proofs, checked through the library and through the
//! `StateReader` contract, in both proof layouts.

use core::text::decode_hex
use std::abi::{Bytes, Bytes32, DynArray, DynString}
use ferrotype::nodes::{AbiList, Packed}
use ferrotype::slots::{BalanceLayout, solidity_mapping, vyper_mapping, address_key}
use ferrotype::state::{self, Account, StateRoot, StorageRoot}
use ferrotype::trie::{ProofError, EMPTY_TRIE_ROOT}
use ingot::{
    mainnet_absent_account,
    mainnet_crv,
    mainnet_eoa_empty_storage,
    mainnet_usdc,
    mainnet_weth,
}

// --- library helpers ---------------------------------------------------------

fn prove_account(_ hex: DynString, root: u256, address: Address) -> Result<ProofError, Account> {
    let buf = decode_hex(hex).unwrap()
    var nodes = Packed::new(start: 0, len: buf.len())
    state::account(
        buf.span(),
        nodes: mut nodes,
        root: StateRoot { value: root },
        address,
    )
}

fn prove_slot(_ hex: DynString, root: u256, slot: u256) -> Result<ProofError, u256> {
    let buf = decode_hex(hex).unwrap()
    var nodes = Packed::new(start: 0, len: buf.len())
    state::storage(
        buf.span(),
        nodes: mut nodes,
        root: StorageRoot { value: root },
        slot,
    )
}

fn expect_account(_ r: Result<ProofError, Account>, storage_root: u256) -> Account {
    match r {
        Result::Ok(account) => {
            assert!(account.storage_root.value == storage_root)
            account
        },
        Result::Err(_) => core::panic(),
    }
}

fn expect_value(_ r: Result<ProofError, u256>, _ value: u256) {
    match r {
        Result::Ok(v) => {
            assert!(v == value)
        },
        Result::Err(_) => {
            assert!(false)
        },
    }
}

fn expect_error(_ r: Result<ProofError, u256>, _ code: u8) {
    match r {
        Result::Ok(_) => {
            assert!(false)
        },
        Result::Err(e) => {
            assert!(contracts::errors::reason_code(e) == code)
        },
    }
}

// --- headers -------------------------------------------------------------------

#[test]
fn header_hash_and_state_root() {
    let buf = decode_hex(mainnet_weth::header()).unwrap()
    let header = state::header(buf.span(), at: 0, len: buf.len()).unwrap()
    assert!(header.hash.value == mainnet_weth::BLOCK_HASH)
    assert!(header.state_root.value == mainnet_weth::STATE_ROOT)
    assert!(header.number == mainnet_weth::BLOCK_NUMBER)
    assert!(header.timestamp == mainnet_weth::TIMESTAMP)
}

#[test]
fn header_with_one_byte_changed_has_another_hash() {
    var buf = decode_hex(mainnet_usdc::header()).unwrap()
    let flipped = buf.span().byte_at(40) ^ 1
    buf.span().write_be<u8>(offset: 40, value: flipped)
    let header = state::header(buf.span(), at: 0, len: buf.len()).unwrap()
    assert!(header.hash.value != mainnet_usdc::BLOCK_HASH)
}

// --- accounts ------------------------------------------------------------------

#[test]
fn usdc_account() {
    let account = expect_account(
        prove_account(
            mainnet_usdc::account_packed(),
            root: mainnet_usdc::STATE_ROOT,
            address: mainnet_usdc::ACCOUNT,
        ),
        storage_root: mainnet_usdc::STORAGE_ROOT,
    )
    assert!(account.exists)
    assert!(account.nonce == mainnet_usdc::NONCE)
    assert!(account.code_hash.value == mainnet_usdc::CODE_HASH)
}

#[test]
fn weth_account_balance() {
    let account = expect_account(
        prove_account(
            mainnet_weth::account_packed(),
            root: mainnet_weth::STATE_ROOT,
            address: mainnet_weth::ACCOUNT,
        ),
        storage_root: mainnet_weth::STORAGE_ROOT,
    )
    assert!(account.balance == mainnet_weth::BALANCE)
}

#[test]
fn absent_account_is_empty() {
    let account = expect_account(
        prove_account(
            mainnet_absent_account::account_packed(),
            root: mainnet_absent_account::STATE_ROOT,
            address: mainnet_absent_account::ACCOUNT,
        ),
        storage_root: EMPTY_TRIE_ROOT,
    )
    assert!(!account.exists)
    assert!(account.balance == 0)
}

#[test]
fn eoa_has_balance_and_no_storage() {
    let account = expect_account(
        prove_account(
            mainnet_eoa_empty_storage::account_packed(),
            root: mainnet_eoa_empty_storage::STATE_ROOT,
            address: mainnet_eoa_empty_storage::ACCOUNT,
        ),
        storage_root: EMPTY_TRIE_ROOT,
    )
    assert!(account.exists)
    assert!(account.balance == mainnet_eoa_empty_storage::BALANCE)
    assert!(account.code_hash.value == state::EMPTY_CODE_HASH)
}

#[test]
fn account_proof_under_another_blocks_root_fails() {
    match prove_account(
        mainnet_usdc::account_packed(),
        root: mainnet_weth::STATE_ROOT,
        address: mainnet_usdc::ACCOUNT,
    ) {
        Result::Err(ProofError::HashMismatch) => {},
        _ => {
            assert!(false)
        },
    }
}

// --- storage ---------------------------------------------------------------------

#[test]
fn usdc_balance_of_blacklisted_holder() {
    expect_value(
        prove_slot(
            mainnet_usdc::slot0_packed(),
            root: mainnet_usdc::STORAGE_ROOT,
            slot: mainnet_usdc::SLOT0,
        ),
        mainnet_usdc::SLOT0_VALUE,
    )
    // USDC packs a blacklist flag into the top bit of the balance word.
    let layout = BalanceLayout::FlaggedSolidity(9)
    let balance = layout.balance(mainnet_usdc::SLOT0_VALUE)
    assert!(balance.flagged)
    assert!(balance.amount == 52363119552)
}

#[test]
fn usdc_balance_slot_is_derived_from_the_holder() {
    let holder = Address::new(0x28c6c06298d514db089934071355e5743bf21d60)
    assert!(
        BalanceLayout::FlaggedSolidity(9).slot(holder) == mainnet_usdc::SLOT0,
    )
    assert!(
        solidity_mapping(slot: 9, key: address_key(holder)) == mainnet_usdc::SLOT0,
    )
}

#[test]
fn usdc_second_slot() {
    expect_value(
        prove_slot(
            mainnet_usdc::slot1_packed(),
            root: mainnet_usdc::STORAGE_ROOT,
            slot: mainnet_usdc::SLOT1,
        ),
        mainnet_usdc::SLOT1_VALUE,
    )
}

// CRV is written in Vyper, which hashes a mapping slot as keccak(slot . key),
// the other way round from Solidity's keccak(key . slot).

#[test]
fn crv_header_and_account() {
    let buf = decode_hex(mainnet_crv::header()).unwrap()
    let header = state::header(buf.span(), at: 0, len: buf.len()).unwrap()
    assert!(header.hash.value == mainnet_crv::BLOCK_HASH)
    assert!(header.state_root.value == mainnet_crv::STATE_ROOT)
    let account = expect_account(
        prove_account(
            mainnet_crv::account_packed(),
            root: mainnet_crv::STATE_ROOT,
            address: mainnet_crv::ACCOUNT,
        ),
        storage_root: mainnet_crv::STORAGE_ROOT,
    )
    assert!(account.nonce == mainnet_crv::NONCE)
}

#[test]
fn crv_balance_is_read_with_the_vyper_layout() {
    expect_value(
        prove_slot(
            mainnet_crv::slot0_packed(),
            root: mainnet_crv::STORAGE_ROOT,
            slot: mainnet_crv::SLOT0,
        ),
        mainnet_crv::SLOT0_VALUE,
    )
    // balanceOf(0xF977…aceC) returned this at the same block.
    assert!(mainnet_crv::SLOT0_VALUE == 50594985519548498304338096)
    let layout = BalanceLayout::Vyper(3)
    let balance = layout.balance(mainnet_crv::SLOT0_VALUE)
    assert!(!balance.flagged)
    assert!(balance.amount == 50594985519548498304338096)
}

#[test]
fn crv_balance_slot_is_derived_from_the_holder() {
    let holder = Address::new(0xf977814e90da44bfa03b6295a0616a897441acec)
    assert!(BalanceLayout::Vyper(3).slot(holder) == mainnet_crv::SLOT0)
    assert!(
        vyper_mapping(slot: 3, key: address_key(holder)) == mainnet_crv::SLOT0,
    )
    // The same index under Solidity's rule names a different slot.
    assert!(
        solidity_mapping(slot: 3, key: address_key(holder)) != mainnet_crv::SLOT0,
    )
}

#[test]
fn weth_zero_balance_is_an_absence_proof() {
    expect_value(
        prove_slot(
            mainnet_weth::slot0_packed(),
            root: mainnet_weth::STORAGE_ROOT,
            slot: mainnet_weth::SLOT0,
        ),
        0,
    )
}

#[test]
fn slot_of_absent_account_is_zero_with_no_nodes() {
    expect_value(
        prove_slot(
            mainnet_absent_account::slot0_packed(),
            root: EMPTY_TRIE_ROOT,
            slot: 0,
        ),
        0,
    )
}

#[test]
fn storage_proof_for_another_slot_is_rejected() {
    // The USDC holder's proof does not prove slot 0 of the same trie.
    let r = prove_slot(
        mainnet_usdc::slot0_packed(),
        root: mainnet_usdc::STORAGE_ROOT,
        slot: 0,
    )
    match r {
        Result::Ok(_) => {
            assert!(false)
        },
        Result::Err(_) => {},
    }
}

#[test]
fn tampered_node_is_rejected() {
    var buf = decode_hex(mainnet_usdc::slot0_packed()).unwrap()
    // Change one byte inside the second node.
    let at: usize = 600
    let flipped = buf.span().byte_at(at) ^ 0x01
    buf.span().write_be<u8>(offset: at, value: flipped)
    var nodes = Packed::new(start: 0, len: buf.len())
    let r = state::storage(
        buf.span(),
        nodes: mut nodes,
        root: StorageRoot { value: mainnet_usdc::STORAGE_ROOT },
        slot: mainnet_usdc::SLOT0,
    )
    expect_error(r, 2)
}

#[test]
fn truncated_proof_is_rejected() {
    let full = decode_hex(mainnet_usdc::slot0_packed()).unwrap()
    // Drop the last node (67 bytes).
    var nodes = Packed::new(start: 0, len: full.len() - 67)
    let r = state::storage(
        full.span(),
        nodes: mut nodes,
        root: StorageRoot { value: mainnet_usdc::STORAGE_ROOT },
        slot: mainnet_usdc::SLOT0,
    )
    expect_error(r, 3)
}

#[test]
fn trailing_node_is_rejected() {
    // The WETH absence proof followed by the USDC proof's first node.
    var hex = mainnet_weth::slot0_packed()
    let extra = decode_hex(mainnet_usdc::slot0_packed()).unwrap()
    let weth = decode_hex(hex).unwrap()
    var joined = core::ptr::MemBuffer::new(weth.len() + 532)
    joined.copy_from(dest_offset: 0, weth.span())
    joined.copy_from(
            dest_offset: weth.len(),
            extra.span().slice(offset: 0, len: 532),
        )
    var nodes = Packed::new(start: 0, len: joined.len())
    let r = state::storage(
        joined.span(),
        nodes: mut nodes,
        root: StorageRoot { value: mainnet_weth::STORAGE_ROOT },
        slot: mainnet_weth::SLOT0,
    )
    expect_error(r, 4)
}

// --- the ABI bytes[] layout ----------------------------------------------------------

#[test]
fn abi_list_layout_reads_the_same_nodes() {
    let list = mainnet_usdc::slot0_list()
    let buf = list.encoded_span()
    var nodes = AbiList::new(buf, base: 0).unwrap()
    let r = state::storage(
        buf,
        nodes: mut nodes,
        root: StorageRoot { value: mainnet_usdc::STORAGE_ROOT },
        slot: mainnet_usdc::SLOT0,
    )
    expect_value(r, mainnet_usdc::SLOT0_VALUE)
}
