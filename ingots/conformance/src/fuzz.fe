//! Mutation fuzzing of real mainnet proofs.
//!
//! Each round takes one of the mainnet proofs, damages it at random (flips a
//! bit, overwrites a byte, cuts the tail, removes a range, appends bytes, or
//! copies a 32-byte window over another, which can turn one hash reference
//! into another) and verifies it. Two invariants hold for every round:
//!
//! - the verifier returns a verdict and never panics, whatever the bytes;
//! - it never proves a value other than the true one: a damaged proof either
//!   still proves the true value (the damage missed every byte that matters)
//!   or is rejected.
//!
//! Every verdict is folded into a digest. The same seed gives the same
//! digest on every target only if every verdict is the same, so one constant
//! checks that the EVM and native builds agree, round by round.

use core::ptr::{MemBuffer, MemSpan}
use core::text::decode_hex
use ferrotype::hash::keccak_words
use ferrotype::nodes::Packed
use ferrotype::state::{self, StateRoot, StorageRoot}
use ferrotype::trie::ProofError
use ingot::{mainnet_usdc, mainnet_weth}

/// A xorshift64* generator: deterministic, so a failing round can be replayed.
struct Rng { state: u64 }

impl Rng {
    fn new(_ seed: u64) -> Self {
        Rng { state: if seed == 0 { 0x9e3779b97f4a7c15 } else { seed } }
    }

    fn next(mut self) -> u64 {
        var x = self.state
        x = x ^ (x >> 12)
        x = x ^ (x << 25)
        x = x ^ (x >> 27)
        self.state = x
        x.wrapping_mul(0x2545f4914f6cdd1d)
    }

    fn below(mut self, _ n: usize) -> usize {
        let r: usize = (self.next() >> 1).downcast_truncate()
        r % n
    }
}

/// Verdicts, as folded into the digest.
const SAME_VALUE: u256 = 0
const WRONG_VALUE: u256 = 100

/// The outcome of a fuzzing run.
pub struct Outcome { pub digest: u256, pub accepted: usize, pub rejected: usize, pub wrong: usize }

impl Copy for Outcome {}

/// Runs `rounds` rounds from `seed`.
pub fn run(rounds: usize, seed: u64) -> Outcome {
    let slot0 = decode_hex(mainnet_usdc::slot0_packed()).unwrap()
    let slot1 = decode_hex(mainnet_usdc::slot1_packed()).unwrap()
    let weth = decode_hex(mainnet_weth::slot0_packed()).unwrap()
    let account = decode_hex(mainnet_usdc::account_packed()).unwrap()
    var rng = Rng::new(seed)
    var outcome = Outcome { digest: 0, accepted: 0, rejected: 0, wrong: 0 }
    var round: usize = 0
    while round < rounds {
        let case = rng.below(4)
        let verdict = if case == 0 {
            storage_round(
                slot0.span(),
                mut rng,
                root: mainnet_usdc::STORAGE_ROOT,
                slot: mainnet_usdc::SLOT0,
                truth: mainnet_usdc::SLOT0_VALUE,
            )
        } else if case == 1 {
            storage_round(
                slot1.span(),
                mut rng,
                root: mainnet_usdc::STORAGE_ROOT,
                slot: mainnet_usdc::SLOT1,
                truth: mainnet_usdc::SLOT1_VALUE,
            )
        } else if case == 2 {
            storage_round(
                weth.span(),
                mut rng,
                root: mainnet_weth::STORAGE_ROOT,
                slot: mainnet_weth::SLOT0,
                truth: 0,
            )
        } else {
            account_round(account.span(), mut rng)
        }
        if verdict == SAME_VALUE {
            outcome.accepted += 1
        } else if verdict == WRONG_VALUE {
            outcome.wrong += 1
        } else {
            outcome.rejected += 1
        }
        outcome.digest = keccak_words([outcome.digest, verdict])
        round += 1
    }
    outcome
}

fn storage_round(_ base: MemSpan, _ rng: mut Rng, root: u256, slot: u256, truth: u256) -> u256 {
    let damaged = mutate(base, mut rng)
    var nodes = Packed::new(start: 0, len: damaged.len())
    match state::storage(
        damaged.span(),
        nodes: mut nodes,
        root: StorageRoot { value: root },
        slot,
    ) {
        Result::Ok(value) => if value == truth {
            SAME_VALUE
        } else {
            WRONG_VALUE
        },
        Result::Err(e) => code(e),
    }
}

fn account_round(_ base: MemSpan, _ rng: mut Rng) -> u256 {
    let damaged = mutate(base, mut rng)
    var nodes = Packed::new(start: 0, len: damaged.len())
    match state::account(
        damaged.span(),
        nodes: mut nodes,
        root: StateRoot { value: mainnet_usdc::STATE_ROOT },
        address: mainnet_usdc::ACCOUNT,
    ) {
        Result::Ok(account) => {
            if account.exists
                && account.storage_root.value == mainnet_usdc::STORAGE_ROOT
                && account.nonce == mainnet_usdc::NONCE {
                SAME_VALUE
            } else {
                WRONG_VALUE
            }
        },
        Result::Err(e) => code(e),
    }
}

// A damaged copy of `base`.
fn mutate(_ base: MemSpan, _ rng: mut Rng) -> MemBuffer {
    let len = base.len()
    let kind = rng.below(6)
    if kind == 2 {
        // Cut the tail.
        return MemBuffer::from_span(base.slice(offset: 0, len: rng.below(len)))
    }
    if kind == 3 {
        // Remove a range from the middle.
        let at = rng.below(len)
        let n = 1 + rng.below(len - at)
        var out = MemBuffer::from_span(base.slice(offset: 0, len: at))
        out.extend_from(base.slice(offset: at + n, len: len - at - n))
        return out
    }
    var out = MemBuffer::from_span(base)
    if kind == 0 {
        // Flip one bit.
        let at = rng.below(len)
        let shift: u8 = rng.below(8).downcast_truncate()
        let bit: u8 = (1 as u8) << shift
        let flipped = out.span().byte_at(at) ^ bit
        out.span().write_be<u8>(offset: at, value: flipped)
    } else if kind == 1 {
        // Overwrite one byte.
        let at = rng.below(len)
        let byte: u8 = (rng.next() & 0xff).downcast_truncate()
        out.span().write_be<u8>(offset: at, value: byte)
    } else if kind == 4 {
        // Append bytes.
        var extra = 1 + rng.below(64)
        while extra > 0 {
            out.push((rng.next() & 0xff).downcast_truncate())
            extra -= 1
        }
    } else if len >= 64 {
        // Copy one 32-byte window over another.
        let from = rng.below(len - 32)
        let to = rng.below(len - 32)
        let window = out.span().read_word(from)
        out.span().write_word(offset: to, value: window)
    }
    out
}

fn code(_ e: ProofError) -> u256 {
    match e {
        ProofError::Malformed => 1,
        ProofError::HashMismatch => 2,
        ProofError::MissingNode => 3,
        ProofError::ExtraNodes => 4,
        ProofError::BadReference => 5,
    }
}

/// The digest of the first 300 rounds from seed 2026, as the native build
/// computed it. The test below recomputes it on whichever target runs it; a
/// build that disagrees on any single verdict gets another digest.
pub const DIGEST_300: u256 = 0x6fb911790fa7b44d308b2a98786ddce1dfa6b2e9d6725631a4d66fa481f1c9b6

#[test]
fn every_target_reaches_the_same_300_verdicts() {
    let outcome = run(rounds: 300, seed: 2026)
    assert!(outcome.wrong == 0)
    assert!(outcome.digest == DIGEST_300)
}
