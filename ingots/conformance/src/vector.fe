//! Checks one generated proof vector against its expected verdict.

use core::text::decode_hex
use std::abi::DynString
use ferrotype::nodes::Packed
use ferrotype::state
use ferrotype::trie::{self, Lookup, ProofError}

/// `expect` is 0 for a present key holding `word`, 100 for an absent key, or
/// the code of the error the proof must be rejected with. Every vector is a
/// storage trie, so a present key's value is read as `state::storage` reads
/// it.
pub fn check(root: u256, key: u256, path: u256, proof: DynString, expect: u8, word: u256) {
    // The path is the key's Keccak-256 hash on every target.
    assert!(state::slot_path(key) == path)
    let buf = decode_hex(proof).unwrap()
    var nodes = Packed::new(start: 0, len: buf.len())
    match trie::lookup(buf.span(), nodes: mut nodes, root, path) {
        Result::Ok(Lookup::Found(item)) => {
            // A storage leaf: its value must be a canonical integer.
            match state::slot_value(buf.span(), item) {
                Result::Ok(value) => {
                    assert!(expect == 0)
                    assert!(value == word)
                },
                Result::Err(e) => {
                    assert!(code(e) == expect)
                },
            }
        },
        Result::Ok(Lookup::Absent) => {
            assert!(expect == 100)
        },
        Result::Err(e) => {
            assert!(code(e) == expect)
        },
    }
}

fn code(_ e: ProofError) -> u8 {
    match e {
        ProofError::Malformed => 1,
        ProofError::HashMismatch => 2,
        ProofError::MissingNode => 3,
        ProofError::ExtraNodes => 4,
        ProofError::BadReference => 5,
    }
}
